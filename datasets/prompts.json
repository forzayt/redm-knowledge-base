  "framework_patterns": {
    "ns-lib_RegisterPrompt": {
      "template": "exports['ns_lib']:RegisterPrompt(slug, {text, key, hold, enabled, visible, group}, entityOrCoords, onCompleteCb, onHoldTickCb)",
      "auto_cleanup_on_entity_delete": true,
      "supports_prompt_groups_native": true
    },
    "vorp_core_Prompt": {
      "template": "local p = exports.vorp_core:vorpPrompt() p:Register(text, key, hold, entity, function() end) p:Start()",
      "source": "https://docs.vorp-core.com/api-reference/lib#prompts"
    },
    "rsg_core_Prompt": {
      "template": "exports['rsg-core']:client:createPrompt({text, key, hold, distance, marker}, function() end)",
      "source": "Rexshack-RedM rsg-core client lib exports"
    },
    "raw_native_lua_pattern": {
      "template": [
        "local prompt = PromptRegisterBegin()",
        "PromptSetControlAction(prompt, 51) -- INPUT_CONTEXT (R)",
        "PromptSetText(prompt, CreateVarString(10, 'LITERAL_STRING', 'Interact'))",
        "PromptSetEnabled(prompt, 1)",
        "PromptSetVisible(prompt, 1)",
        "PromptRegisterEnd(prompt)",
        "-- each tick:",
        "if PromptHasStandardModeCompleted(prompt, 0) then onHit() end"
      ],
      "source": "femga rdr3_discoveries UI prompt list"
    }
  }
